# Local configuration template. Never commit actual passwords.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_grade_monitoring_db
DB_USERNAME=sgms_app
DB_PASSWORD=
DB_SYNCHRONIZE=false
DB_MIGRATION_USERNAME=sgms_migrator
DB_MIGRATION_PASSWORD=

# Generate once: 64 random bytes encoded as 128 hexadecimal characters.
# Never replace this placeholder with an actual secret in Git.
JWT_SECRET=
JWT_EXPIRES_IN=30m
